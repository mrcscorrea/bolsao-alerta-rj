# URL base do projeto na MockAPI (https://mockapi.io) — recurso "relatos"
VITE_MOCKAPI_URL=https://SEU_ID.mockapi.io

# Canal público do ThingSpeak alimentado pelo ESP32 (field2 = nível cm, field3 = severidade 0/1/2)
VITE_THINGSPEAK_CHANNEL=3586321
# Qual via recebe os dados reais do sensor
VITE_THINGSPEAK_VIA=av-brasil-mare

# Fórum (Supabase): rode supabase/forum.sql no SQL Editor e copie de Project Settings > API
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
