# URL base do projeto na MockAPI (https://mockapi.io) — recurso "relatos"
VITE_MOCKAPI_URL=https://SEU_ID.mockapi.io/api/v1

# Canal público do ThingSpeak alimentado pelo ESP32 (field1 = lâmina cm, field2 = chuva mm/h)
VITE_THINGSPEAK_CHANNEL=
# Qual via recebe os dados reais do sensor
VITE_THINGSPEAK_VIA=av-brasil-mare
